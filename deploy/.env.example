# MealMind 项目环境变量示例。
# 复制为 deploy/.env 后填写真实值；.env 已被 .gitignore 忽略，切勿提交仓库。
# 服务器上 MySQL / Redis 的口令沿用基础设施 /opt/infra/.env 的定义，
# 这里重复一份引用即可，不互相修改。

# —— 镜像仓库（CI 推送 ghcr.io/<owner>/mealmind-{web,api,agent}）——
MEALMIND_IMAGE_PREFIX=ghcr.io/owner/mealmind
MEALMIND_IMAGE_TAG=latest

# —— 共享 MySQL（库 mealmind 与独立账号在首次部署时创建，不复用 root）——
MYSQL_DATABASE=mealmind
MYSQL_USER=mealmind
MYSQL_PASSWORD=change-me

# —— 共享 Redis（键前缀 mealmind: 与其它项目隔离）——
REDIS_PASSWORD=change-me

# —— 服务间令牌（api ↔ agent）——
MEALMIND_INTERNAL_TOKEN=change-me

# —— 模型接入（只注入 agent 容器；决策模型与生成式模型都走阿里云百炼）——
# 打分通道：AUTO 优先决策模型、失败自动降级规则；RULE 强制规则；DECISION 强制决策模型
# 2026-10-12 起原 Jev（TeamoRouter）下线，主通道平替为百炼 decision-model-preview（同 System One 协议，限时免费）
SCORER_MODE=AUTO

# 决策模型（System One 原生格式，端点 /compatible-mode/v1/systemone）
# API Host 从百炼控制台复制：API-KEY 页创建弹窗 或「业务空间管理」页的 API Host 列
# 形如 https://llm-xxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1（业务空间专属域名，生产推荐；
# 留空则用代码默认的试用域名 https://trial.cn-beijing.maas.aliyuncs.com/compatible-mode/v1，官方不建议生产）
DECISION_API_KEY=
DECISION_BASE_URL=
DECISION_MODEL=decision-model-preview

# 生成式模型（理解与表达）：百炼 qwen3.8；模型 ID 与端点以百炼控制台为准
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash

# 降级状态机阈值（技术方案 §6.1）：失败率超 0.3 转 FULL、全量降级后冷却 60s 再探测
DEGRADE_PARTIAL_THRESHOLD=0.3
DEGRADE_COOLDOWN_SECONDS=60

# 模型调用超时（秒，技术方案 §6.4）：依据 qwen3.8-flash 关闭思考模式后的实测延迟
UNDERSTAND_TIMEOUT_S=3
PHRASE_TIMEOUT_S=4
